# ── Dependencies ─────────────────────────────────────────────────────────────
node_modules/
*/node_modules/
backend/node_modules/
frontend/node_modules/
.pnpm-store/
.yarn/
.yarn-cache/

# ── Environment & Security (Secrets, Tokens, Passwords) ─────────────────────
.env
.env.*
*.env
backend/.env
frontend/.env
.env.local
.env.development.local
.env.test.local
.env.production.local
# Explicitly keep example environment templates
!.env.example
!backend/.env.example
!frontend/.env.example

# ── Build & Distribution Outputs ─────────────────────────────────────────────
dist/
dist-ssr/
frontend/dist/
build/
out/
.vite/
frontend/.vite/
.cache/
*.tsbuildinfo

# ── Logs & Debugging Output ──────────────────────────────────────────────────
logs/
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*

# ── Testing & Coverage Reports ───────────────────────────────────────────────
coverage/
*.lcov
.nyc_output/

# ── Uploads & Temporary Runtime Files ────────────────────────────────────────
tmp/
temp/
backend/uploads/
uploads/
scratch/
.gemini/
.system_generated/
artifacts/

# ── Operating System Artifacts ────────────────────────────────────────────────
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
ehthumbs.db
Thumbs.db
Desktop.ini
$RECYCLE.BIN/

# ── IDEs & Code Editors ───────────────────────────────────────────────────────
.vscode/*
!.vscode/settings.json
!.vscode/tasks.json
!.vscode/launch.json
!.vscode/extensions.json
.idea/
*.swp
*.swo
*.suo
*.ntvs*
*.njsproj
*.sln
.eslintcache
