# Server Port
PORT=5000

# Environment Mode (development | production)
NODE_ENV=development

# MongoDB Connection String (Atlas URI or local mongodb://localhost:27017/recruitx)
MONGO_URI=mongodb+srv://<username>:<password>@cluster0.example.mongodb.net/recruitx?retryWrites=true&w=majority

# JWT Authentication Secret
JWT_SECRET=your_super_secret_jwt_key_here

# Open-Source / HuggingFace Inference API Key (Optional for Open-Source Qwen 2.5 Validation)
HUGGINGFACE_API_KEY=your_huggingface_api_token_here

# ── Google Calendar & Google Meet API Integration ──────────────────────────
# Option 1: OAuth2 Credentials (Recommended for user Google Calendar sync)
GOOGLE_CLIENT_ID=your_google_client_id_here.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your_google_client_secret_here
GOOGLE_REFRESH_TOKEN=your_google_oauth_refresh_token_here
GOOGLE_REDIRECT_URI=http://localhost:5000/api/auth/google/callback
GOOGLE_CALENDAR_ID=primary

# Option 2: Google Service Account (Alternative for automated organization calendar)
# GOOGLE_SERVICE_ACCOUNT_EMAIL=recruitx-calendar-service@your-project.iam.gserviceaccount.com
# GOOGLE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----\n"

# ── SMTP Email Dispatch (Optional: uses Ethereal test account by default) ──
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=587
# SMTP_USER=your_email@gmail.com
# SMTP_PASS=your_app_specific_password_here
# EMAIL_FROM="RecruitX Platform" <no-reply@recruitx.ai>
